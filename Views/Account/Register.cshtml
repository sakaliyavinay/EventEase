@model EventEase.Models.RegisterViewModel
@{
    ViewData["Title"] = "User Sign Up";
}

<div class="bg-dark text-white py-4 mb-4 border-bottom border-primary border-3">
    <div class="container">
        <h1 class="fw-bold mb-1"><i class="bi bi-person-plus-fill text-primary me-2"></i>Create New Account</h1>
        <p class="text-light opacity-75 mb-0">Join EventEase today to discover, reserve, and manage event passes easily.</p>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle d-inline-block mb-2 fs-2">
                        <i class="bi bi-person-lines-fill"></i>
                    </div>
                    <h3 class="fw-bold">Sign Up for EventEase</h3>
                    <p class="text-muted small">It only takes a minute to create your free account.</p>
                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Full Name *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Alex Johnson" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="alex@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold">Phone Number *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" class="form-control" placeholder="+1 (555) 019-2834" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold">Password *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-shield-lock"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="AgreeTerms" class="form-check-input" />
                        <label asp-for="AgreeTerms" class="form-check-label small text-muted">
                            I agree to the <a href="#" class="text-primary text-decoration-none">Terms of Service</a> and <a href="#" class="text-primary text-decoration-none">Privacy Policy</a>
                        </label>
                        <span asp-validation-for="AgreeTerms" class="text-danger small d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow mb-3">
                        <i class="bi bi-person-check-fill me-2"></i> Create Account
                    </button>

                    <div class="text-center text-muted small border-top pt-3">
                        Already have an account? 
                        <a asp-action="Login" class="fw-bold text-primary text-decoration-none ms-1">Log In Here</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
