@model EventEase.Models.UserModel
@{
    ViewData["Title"] = "User Profile";
    var userBookings = ViewBag.UserBookings as List<EventEase.Models.BookedTicketModel> ?? new List<EventEase.Models.BookedTicketModel>();
}

<div class="bg-dark text-white py-4 mb-4 border-bottom border-primary border-3">
    <div class="container">
        <h1 class="fw-bold mb-1"><i class="bi bi-person-badge-fill text-primary me-2"></i>My Profile Dashboard</h1>
        <p class="text-light opacity-75 mb-0">Manage your account information, ticket reservations, and membership status.</p>
    </div>
</div>

<div class="container mb-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show p-3 rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Profile Sidebar -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-3 p-4 bg-white text-center">
                <div class="mb-3 position-relative d-inline-block mx-auto">
                    <div class="p-4 bg-primary text-white rounded-circle fs-1 fw-bold" style="width: 100px; height: 100px; line-height: 50px;">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </div>
                </div>
                <h4 class="fw-bold mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-2"><i class="bi bi-envelope me-1"></i>@Model.Email</p>
                <span class="badge bg-primary px-3 py-2 rounded-pill mb-3">@Model.Role</span>

                <div class="border-top pt-3 text-start small">
                    <p class="mb-2"><i class="bi bi-telephone-fill me-2 text-primary"></i><strong>Phone:</strong> @Model.Phone</p>
                    <p class="mb-2"><i class="bi bi-calendar-check-fill me-2 text-success"></i><strong>Member Since:</strong> @Model.JoinedDate.ToString("MMM dd, yyyy")</p>
                    <p class="mb-0"><i class="bi bi-shield-lock-fill me-2 text-warning"></i><strong>Status:</strong> Verified Active Account</p>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <a asp-action="Logout" class="btn btn-outline-danger w-100 fw-semibold">
                        <i class="bi bi-box-arrow-right me-1"></i> Log Out
                    </a>
                </div>
            </div>
        </div>

        <!-- Dashboard Content: User's Booked Tickets -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 p-4 p-md-5 bg-white mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                    <h4 class="fw-bold mb-0"><i class="bi bi-ticket-perforated text-primary me-2"></i>My Booked Tickets</h4>
                    <span class="badge bg-success px-3 py-2 rounded-pill fs-6">@userBookings.Count Ticket(s) Found</span>
                </div>
                
                @if (!userBookings.Any())
                {
                    <div class="p-5 bg-light rounded-3 text-center my-3 border">
                        <i class="bi bi-ticket-detailed text-muted display-3 mb-3 d-block"></i>
                        <h5 class="fw-bold text-dark mb-1">No Tickets Booked Yet</h5>
                        <p class="text-muted small mb-4">When you book event passes on EventEase, your digital passes will automatically show up right here.</p>
                        <a asp-controller="Home" asp-action="Events" class="btn btn-primary fw-semibold">
                            <i class="bi bi-compass-fill me-1"></i> Browse & Book Tickets
                        </a>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3 my-3">
                        @foreach (var ticket in userBookings)
                        {
                            <div class="card border shadow-xs rounded-3 overflow-hidden bg-white">
                                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2 px-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-ticket-perforated-fill text-primary"></i>
                                        <span class="fw-bold small">Ref: @ticket.BookingReference</span>
                                    </div>
                                    <span class="badge bg-success">Confirmed</span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="row align-items-center gy-2">
                                        <div class="col-md-7">
                                            <h5 class="fw-bold text-dark mb-1">@ticket.EventTitle</h5>
                                            <p class="small text-muted mb-1"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@ticket.EventLocation</p>
                                            <p class="small text-muted mb-0"><i class="bi bi-calendar-event text-primary me-1"></i>Event Date: <strong>@ticket.EventDate</strong></p>
                                        </div>
                                        <div class="col-md-5 text-md-end border-start-md pt-2 pt-md-0">
                                            <span class="badge bg-primary mb-1">@ticket.TicketType</span>
                                            <p class="small mb-1">Quantity: <strong>@ticket.Quantity Ticket(s)</strong></p>
                                            <h5 class="fw-bold text-success mb-0">Total: ₹@ticket.TotalAmount.ToString("N0")</h5>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-light py-2 px-3 d-flex justify-content-between align-items-center small">
                                    <span class="text-muted">Booked on @ticket.BookingDate.ToString("MMM dd, yyyy hh:mm tt")</span>
                                    <span class="text-primary fw-semibold"><i class="bi bi-qr-code me-1"></i>Digital Pass Ready</span>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a asp-controller="Home" asp-action="Events" class="btn btn-outline-primary fw-semibold">
                        <i class="bi bi-compass-fill me-1"></i> Explore More Events
                    </a>
                    <a asp-controller="Home" asp-action="Booking" class="btn btn-primary fw-semibold">
                        <i class="bi bi-plus-circle-fill me-1"></i> Book New Ticket
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
