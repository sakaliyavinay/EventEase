@model EventEase.Models.UserModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="bg-dark text-white py-4 mb-4 border-bottom border-primary border-3">
    <div class="container">
        <h1 class="fw-bold mb-1"><i class="bi bi-person-badge-fill text-primary me-2"></i>My Profile Dashboard</h1>
        <p class="text-light opacity-75 mb-0">Manage your account information, ticket reservations, and membership status.</p>
    </div>
</div>

<div class="container mb-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show p-3 rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Profile Sidebar -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-3 p-4 bg-white text-center">
                <div class="mb-3 position-relative d-inline-block mx-auto">
                    <div class="p-4 bg-primary text-white rounded-circle fs-1 fw-bold" style="width: 100px; height: 100px; line-height: 50px;">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </div>
                </div>
                <h4 class="fw-bold mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-2"><i class="bi bi-envelope me-1"></i>@Model.Email</p>
                <span class="badge bg-primary px-3 py-2 rounded-pill mb-3">@Model.Role</span>

                <div class="border-top pt-3 text-start small">
                    <p class="mb-2"><i class="bi bi-telephone-fill me-2 text-primary"></i><strong>Phone:</strong> @Model.Phone</p>
                    <p class="mb-2"><i class="bi bi-calendar-check-fill me-2 text-success"></i><strong>Member Since:</strong> @Model.JoinedDate.ToString("MMM dd, yyyy")</p>
                    <p class="mb-0"><i class="bi bi-shield-lock-fill me-2 text-warning"></i><strong>Status:</strong> Verified Active Account</p>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <a asp-action="Logout" class="btn btn-outline-danger w-100 fw-semibold">
                        <i class="bi bi-box-arrow-right me-1"></i> Log Out
                    </a>
                </div>
            </div>
        </div>

        <!-- Dashboard Content -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 p-4 p-md-5 bg-white mb-4">
                <h4 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-ticket-perforated text-primary me-2"></i>My Booked Tickets</h4>
                
                <div class="p-4 bg-light rounded-3 border text-center my-3">
                    <div class="fs-2 text-muted mb-2"><i class="bi bi-calendar-check"></i></div>
                    <h5 class="fw-bold mb-1">Active Ticket Passes</h5>
                    <p class="text-muted small mb-3">You have 1 active ticket pass registered under <strong>@Model.Email</strong>.</p>
                    
                    <div class="card border text-start shadow-xs p-3 bg-white mx-auto" style="max-width: 500px;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-success">Confirmed</span>
                            <span class="small text-muted fw-bold">Ref: EE-8A92B104</span>
                        </div>
                        <h6 class="fw-bold mb-1">Global Tech Summit 2026</h6>
                        <p class="small text-muted mb-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Silicon Convention Center | Oct 15, 2026</p>
                        <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                            <span class="small">1x Standard Pass</span>
                            <a asp-controller="Home" asp-action="Booking" class="btn btn-sm btn-outline-primary fw-semibold">View Ticket Pass</a>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-controller="Home" asp-action="Events" class="btn btn-primary fw-semibold">
                        <i class="bi bi-compass-fill me-1"></i> Explore More Events
                    </a>
                    <a asp-controller="Home" asp-action="Booking" class="btn btn-outline-primary fw-semibold">
                        <i class="bi bi-plus-circle-fill me-1"></i> Book New Ticket
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
