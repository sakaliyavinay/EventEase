@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventEase</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EventEase.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow border-bottom border-primary border-3 py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-uppercase fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-ticket-perforated-fill text-primary"></i> Event<span class="text-primary">Ease</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 fw-semibold align-items-lg-center gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-2 @(ViewData["Title"]?.ToString() == "Home - EventEase" || ViewData["Title"]?.ToString() == "Home" ? "active text-primary fw-bold" : "")" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-2 @(ViewData["Title"]?.ToString()?.Contains("Browse Events") == true ? "active text-primary fw-bold" : "")" asp-area="" asp-controller="Home" asp-action="Events">
                                <i class="bi bi-calendar-event-fill me-1"></i> Events Catalog
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-2 @(ViewData["Title"]?.ToString()?.Contains("Services") == true ? "active text-primary fw-bold" : "")" asp-area="" asp-controller="Home" asp-action="Services">
                                <i class="bi bi-grid-fill me-1"></i> Services
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-2 @(ViewData["Title"]?.ToString()?.Contains("About") == true ? "active text-primary fw-bold" : "")" asp-area="" asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle-fill me-1"></i> About Us
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-2 @(ViewData["Title"]?.ToString()?.Contains("Contact") == true ? "active text-primary fw-bold" : "")" asp-area="" asp-controller="Home" asp-action="Contact">
                                <i class="bi bi-envelope-fill me-1"></i> Contact Us
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary text-white fw-bold px-3 py-1 shadow-sm ms-lg-2 d-inline-flex align-items-center gap-1" asp-area="" asp-controller="Home" asp-action="Booking">
                                <i class="bi bi-ticket-fill"></i> Book Ticket
                            </a>
                        </li>

                        <!-- User Management Navbar Items -->
                        @{
                            var userName = Context.Session.GetString("UserName");
                        }
                        @if (!string.IsNullOrEmpty(userName))
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-outline-light fw-semibold px-3 py-1 d-inline-flex align-items-center gap-1" asp-controller="Account" asp-action="Profile">
                                    <i class="bi bi-person-circle text-primary"></i> @userName
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm px-2 py-1 ms-1" asp-controller="Account" asp-action="Logout" title="Log Out">
                                    <i class="bi bi-box-arrow-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-outline-light fw-semibold px-3 py-1 me-1" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Log In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-success fw-bold px-3 py-1 text-white shadow-sm" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus-fill me-1"></i> Sign Up
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 pb-5">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white border-top border-secondary mt-auto py-5">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-ticket-perforated-fill"></i> EventEase</h5>
                    <p class="small text-secondary mb-0 leading-relaxed">Your ultimate destination for discovering, hosting, and booking tickets for top concerts, tech conferences, workshops, and sports events worldwide.</p>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="fw-bold text-white mb-3 text-uppercase small tracking-wider">Quick Navigation</h6>
                    <ul class="list-unstyled small mb-0 d-flex flex-column gap-2">
                        <li><a class="text-secondary text-decoration-none hover-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right me-1 small text-primary"></i> Home</a></li>
                        <li><a class="text-secondary text-decoration-none hover-primary" asp-controller="Home" asp-action="Events"><i class="bi bi-chevron-right me-1 small text-primary"></i> Events Catalog</a></li>
                        <li><a class="text-secondary text-decoration-none hover-primary" asp-controller="Home" asp-action="Services"><i class="bi bi-chevron-right me-1 small text-primary"></i> Services</a></li>
                        <li><a class="text-secondary text-decoration-none hover-primary" asp-controller="Home" asp-action="About"><i class="bi bi-chevron-right me-1 small text-primary"></i> About Us</a></li>
                        <li><a class="text-secondary text-decoration-none hover-primary" asp-controller="Account" asp-action="Login"><i class="bi bi-chevron-right me-1 small text-primary"></i> Log In / Account</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-12">
                    <h6 class="fw-bold text-white mb-3 text-uppercase small tracking-wider">Connect With Us</h6>
                    <p class="small text-secondary mb-3">Subscribe for upcoming event alerts & VIP pass discounts.</p>
                    <div class="d-flex gap-3 fs-5 text-secondary mb-3">
                        <a href="#" class="text-secondary text-decoration-none hover-primary"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-secondary text-decoration-none hover-primary"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="text-secondary text-decoration-none hover-primary"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-secondary text-decoration-none hover-primary"><i class="bi bi-linkedin"></i></a>
                    </div>
                    <p class="small text-secondary mb-0">&copy; 2026 EventEase Mini Project - ASP.NET MVC Application</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
