@model IEnumerable<EventEase.Models.EventItem>
@{
    ViewData["Title"] = "Browse Events";
    var currentCategory = ViewData["SelectedCategory"]?.ToString() ?? "All";
    var currentSearch = ViewData["SearchQuery"]?.ToString() ?? "";
}

<div class="bg-dark text-white py-4 mb-4 border-bottom border-primary border-3">
    <div class="container">
        <h1 class="fw-bold mb-1"><i class="bi bi-calendar-event text-primary me-2"></i>Events Catalog</h1>
        <p class="text-light opacity-75 mb-0">Browse through our complete schedule of concerts, tech conferences, workshops, and sports events.</p>
    </div>
</div>

<div class="container mb-5">
    <!-- Filter & Search Bar -->
    <div class="card shadow-sm border-0 mb-4 p-3 bg-white rounded-3">
        <form method="get" asp-action="Events" class="row g-3 align-items-center">
            <div class="col-md-5">
                <label class="form-label fw-semibold small text-muted">Search Event</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Search by title, location or keywords..." value="@currentSearch" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold small text-muted">Category Filter</label>
                <select name="category" class="form-select">
                    <option value="All" selected="@(currentCategory == "All")">All Categories</option>
                    <option value="Tech" selected="@(currentCategory == "Tech")">Tech Conferences</option>
                    <option value="Music" selected="@(currentCategory == "Music")">Music & Concerts</option>
                    <option value="Workshop" selected="@(currentCategory == "Workshop")">Workshops & Culinary</option>
                    <option value="Sports" selected="@(currentCategory == "Sports")">Sports & Marathons</option>
                    <option value="Art" selected="@(currentCategory == "Art")">Art & Exhibitions</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-funnel-fill me-1"></i> Filter
                </button>
                <a asp-action="Events" class="btn btn-outline-secondary fw-semibold">Reset</a>
            </div>
        </form>
    </div>

    <!-- Active Filters Summary -->
    @if (!string.IsNullOrEmpty(currentSearch) || currentCategory != "All")
    {
        <div class="alert alert-info py-2 px-3 mb-4 d-flex align-items-center justify-content-between">
            <div>
                <i class="bi bi-info-circle-fill me-2"></i> Filtering by 
                @if (currentCategory != "All") { <strong>Category: @currentCategory</strong> }
                @if (!string.IsNullOrEmpty(currentSearch)) { <span class="ms-2">Keyword: "<strong>@currentSearch</strong>"</span> }
            </div>
            <a asp-action="Events" class="text-decoration-none text-dark fw-bold small"><i class="bi bi-x-circle me-1"></i> Clear Filters</a>
        </div>
    }

    <!-- Event Cards Grid -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-3 shadow-sm border">
            <i class="bi bi-search text-muted display-1 mb-3"></i>
            <h4 class="fw-bold">No Events Found</h4>
            <p class="text-muted mb-4">We couldn't find any events matching your search criteria.</p>
            <a asp-action="Events" class="btn btn-primary fw-semibold">View All Events</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="card event-card h-100 shadow-sm border">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" />
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary badge-category">@item.Category</span>
                                <span class="fw-bold text-success fs-5">₹@item.Price.ToString("N0")</span>
                            </div>
                            <h5 class="card-title fw-bold text-dark mb-2">@item.Title</h5>
                            <p class="card-text text-muted small flex-grow-1">@item.Description</p>
                            
                            <div class="border-top pt-3 mt-2">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span><i class="bi bi-calendar3 me-1 text-primary"></i>@item.Date</span>
                                    <span><i class="bi bi-clock me-1 text-primary"></i>@item.Time</span>
                                </div>
                                <p class="small text-muted mb-2"><i class="bi bi-geo-alt-fill me-1 text-danger"></i>@item.Location</p>
                                <p class="small text-muted mb-3"><i class="bi bi-person-circle me-1 text-secondary"></i>Organizer: <strong>@item.Organizer</strong></p>
                                
                                <div class="d-flex gap-2">
                                    <a asp-action="Booking" asp-route-id="@item.Id" class="btn btn-primary w-100 fw-semibold">
                                        <i class="bi bi-ticket-fill me-1"></i> Book Ticket
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
