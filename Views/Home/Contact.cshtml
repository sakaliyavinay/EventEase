@model EventEase.Models.ContactFormModel
@{
    ViewData["Title"] = "Contact Us";
}

<div class="bg-dark text-white py-4 mb-4 border-bottom border-primary border-3">
    <div class="container">
        <h1 class="fw-bold mb-1"><i class="bi bi-envelope-fill text-primary me-2"></i>Contact & Support</h1>
        <p class="text-light opacity-75 mb-0">Have questions about your event ticket, venue details, or hosting an event? Reach out to our 24/7 team.</p>
    </div>
</div>

<div class="container mb-5">
    @if (Model.IsSubmitted)
    {
        <div class="alert alert-success p-4 rounded-3 shadow-sm mb-5 text-center">
            <i class="bi bi-check-circle-fill display-4 text-success mb-2 d-block"></i>
            <h3 class="fw-bold">Message Sent Successfully!</h3>
            <p class="mb-3">@ViewBag.SuccessMessage</p>
            <a asp-action="Contact" class="btn btn-outline-success fw-semibold">Send Another Message</a>
        </div>
    }

    <div class="row g-4">
        <!-- Contact Form -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-3 p-4 p-md-5 bg-white">
                <h3 class="fw-bold mb-2">Send Us a Message</h3>
                <p class="text-muted small mb-4">Our support desk responds to queries within 24 hours.</p>

                <form asp-action="Contact" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-semibold">Your Name *</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. John Smith" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address *</label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="john@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label fw-semibold">Subject *</label>
                        <input asp-for="Subject" class="form-control" placeholder="e.g. Ticket Inquiry / Refund Request" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Message" class="form-label fw-semibold">Your Message *</label>
                        <textarea asp-for="Message" class="form-control" rows="5" placeholder="Write your inquiry or question here..."></textarea>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow">
                        <i class="bi bi-send-fill me-2"></i> Submit Inquiry
                    </button>
                </form>
            </div>
        </div>

        <!-- Contact Info & FAQs -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-3 p-4 bg-white mb-4">
                <h4 class="fw-bold mb-4 border-bottom pb-2"><i class="bi bi-geo-alt-fill text-danger me-2"></i>Head Office & Details</h4>

                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="p-2 bg-primary bg-opacity-10 text-primary rounded fs-4"><i class="bi bi-building"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">EventEase Headquarters</h6>
                        <p class="text-muted small mb-0">100 Tech Park Way, Suite 400<br />Innovation City, NY 10001</p>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="p-2 bg-success bg-opacity-10 text-success rounded fs-4"><i class="bi bi-telephone-fill"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">Customer Support Line</h6>
                        <p class="text-muted small mb-0">+1 (800) 555-EASE (3273)<br />Mon - Sun: 8:00 AM - 10:00 PM EST</p>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3 mb-2">
                    <div class="p-2 bg-warning bg-opacity-10 text-warning rounded fs-4"><i class="bi bi-envelope-open-fill"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">Direct Email</h6>
                        <p class="text-muted small mb-0">support@eventease.com<br />partners@eventease.com</p>
                    </div>
                </div>
            </div>

            <!-- FAQs Box -->
            <div class="card shadow-sm border-0 rounded-3 p-4 bg-white">
                <h4 class="fw-bold mb-3"><i class="bi bi-question-circle-fill text-primary me-2"></i>Frequently Asked Questions</h4>
                
                <div class="accordion accordion-flush" id="faqAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingOne">
                            <button class="accordion-button collapsed fw-semibold small" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                                How do I receive my booked ticket?
                            </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted small">
                                Once booked, an instant digital confirmation with a unique QR code reference is generated on screen and emailed to your registered address.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingTwo">
                            <button class="accordion-button collapsed fw-semibold small" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                                Can I upgrade to a VIP pass later?
                            </button>
                        </h2>
                        <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted small">
                                Yes! You can contact support or choose the VIP pass option on the booking portal prior to event commencement.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
