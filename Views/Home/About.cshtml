@{
    ViewData["Title"] = "About Us";
}

<div class="bg-dark text-white py-4 mb-4 border-bottom border-primary border-3">
    <div class="container">
        <h1 class="fw-bold mb-1"><i class="bi bi-info-circle-fill text-primary me-2"></i>About EventEase</h1>
        <p class="text-light opacity-75 mb-0">Empowering organizers and fans with a smooth, reliable event discovery and ticketing experience.</p>
    </div>
</div>

<div class="container mb-5">
    <div class="row align-items-center gy-4 mb-5">
        <div class="col-lg-6">
            <h2 class="fw-bold text-dark mb-3">Connecting People Through Memorable Live Experiences</h2>
            <p class="text-muted leading-relaxed">
                Founded with a passion for live entertainment and professional conferences, <strong>EventEase</strong> has grown into a leading event ticketing platform. We bridge the gap between event organizers and passionate attendees.
            </p>
            <p class="text-muted leading-relaxed">
                Whether you are looking for an intimate coding workshop, a high-octane stadium concert, or an international tech summit, EventEase makes finding and securing your pass effortless and reliable.
            </p>

            <div class="row g-3 mt-3">
                <div class="col-6">
                    <div class="p-3 bg-white rounded shadow-sm border-start border-4 border-primary">
                        <h4 class="fw-bold mb-1 text-primary">500+</h4>
                        <p class="text-muted small mb-0">Events Hosted</p>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 bg-white rounded shadow-sm border-start border-4 border-success">
                        <h4 class="fw-bold mb-1 text-success">50k+</h4>
                        <p class="text-muted small mb-0">Happy Attendees</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <img src="https://images.unsplash.com/photo-1511578314322-379afb476865?w=700&auto=format&fit=crop" class="img-fluid rounded-4 shadow border border-3 border-light" alt="Conference Audience" />
        </div>
    </div>

    <!-- Core Values -->
    <div class="bg-white rounded-3 p-4 p-md-5 shadow-sm border mb-5">
        <div class="text-center mb-4">
            <h3 class="fw-bold">Our Core Pillars</h3>
            <p class="text-muted small">What guides our platform every single day</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="d-flex gap-3">
                    <div class="fs-2 text-primary"><i class="bi bi-shield-check"></i></div>
                    <div>
                        <h5 class="fw-bold mb-1">Authenticity & Safety</h5>
                        <p class="text-muted small mb-0">Every ticket is backed by direct organizer verification to prevent counterfeit entry passes.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex gap-3">
                    <div class="fs-2 text-success"><i class="bi bi-lightning-charge"></i></div>
                    <div>
                        <h5 class="fw-bold mb-1">Speed & Simplicity</h5>
                        <p class="text-muted small mb-0">Complete your ticket booking in under 60 seconds with instant digital e-ticket delivery.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex gap-3">
                    <div class="fs-2 text-warning"><i class="bi bi-heart-fill"></i></div>
                    <div>
                        <h5 class="fw-bold mb-1">Customer First</h5>
                        <p class="text-muted small mb-0">Dedicated support team to resolve ticket changes, refunds, and venue queries smoothly.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
